		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"react-error-boundary": "^4.0.13",
		"react-hook-form": "^7.52.1",
		"react-hot-toast": "^2.4.1",
		"react-icons": "^5.2.1",
		"react-router-dom": "^6.30.3",
		"recharts": "^2.12.7",
		"styled-components": "^6.1.12"
	},
	"devDependencies": {
